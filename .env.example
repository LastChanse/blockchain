DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,portal,node0,node1,node2

# per-service DATABASE_URL задаётся в docker-compose.yml,
# здесь — только для локального запуска без Docker:
DATABASE_URL=postgres://clinic:clinic@localhost:5432/portal

NODE_ROLE=portal
NODE_ID=portal

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

POSTGRES_DB=portal
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_HOST=db
POSTGRES_PORT=5432