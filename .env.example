DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,portal,node0,node1,node2

# per-service DATABASE_URL задаётся в docker-compose.yml,
# здесь — только для локального запуска без Docker:
DATABASE_URL=postgres://clinic:clinic@localhost:5432/portal

NODE_ROLE=portal
NODE_ID=portal

# Токен для межнодового API (/clinic/network/*, /clinic/internal/*).
# Должен совпадать у всех нод и портала.
INTERNAL_SYNC_TOKEN=change-me-internal-token

# Адреса соседних нод через запятую, без слэша на конце.
# Для docker (имена сервисов = node0, node1, node2):
PEERS=http://node1:8000,http://node2:8000

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

POSTGRES_DB=portal
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_HOST=db
POSTGRES_PORT=5432